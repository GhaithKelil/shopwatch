# Copy this file to .env and fill it in. Never commit .env.

# Shops to monitor, comma separated. Each name needs its own tokens file
# (created by `python auth.py <name>`) unless you feed it a CSV export instead.
SHOP_NAMES=myshop

# Etsy API app credentials (https://www.etsy.com/developers/your-apps)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Optional: where token files live (default: current directory)
# TOKENS_DIR=tokens

# Optional: CSV export used when the API returns nothing (single-shop setups).
# With several shops, name the files orders_<shop>.csv instead.
# CSV_PATH=orders.csv

# Telegram alerts (optional; without these, alerts only show on the dashboard and in the logs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage
DB_PATH=data/shopwatch.db

# How often the worker syncs, in seconds
SYNC_INTERVAL_SECONDS=900

# Rule thresholds
LATE_UNSHIPPED_DAYS=3
STUCK_TRANSIT_DAYS=14
REFUND_SPIKE_THRESHOLD_PCT=10.0
BUYER_VELOCITY_MAX_ORDERS=3
BUYER_VELOCITY_WINDOW_HOURS=24
SYNC_STALE_MAX_HOURS=2.0

# Dashboard: browsers allowed to call the API from another origin (comma separated, default none)
# CORS_ORIGINS=
